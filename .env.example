OPENAI_EMAIL=Login Email for OpenAI chatgpt
OPENAI_PASSWORD=Login Password for OpenAi chatgpt

# Optional
PORT=3001
# Requires `Authorization: Bearer <API_KEY>` on /v1/* routes. Unset = open.
API_KEY=

# Docker-only tuning (see Dockerfile / docker-compose.yml) — safe to leave unset.
# PUPPETEER_HEADLESS=false
# PUPPETEER_WINDOW_WIDTH=1920
# PUPPETEER_WINDOW_HEIGHT=540
